#!/bin/zsh
# Double-click to install or repair Jaeger AI on macOS.
cd "${0:A:h}"
print "=========================================="
print "       Welcome to JaegerAI Installer      "
print "=========================================="
print ""
print "This will install JaegerAI to your machine:"
print "  • Python environment in ~/.jaeger/venv"
print "  • All AI packages (agent, OS, voice engines)"
print "  • Native macOS app (if Swift is available)"
print "  • Browser interface (WebUI)"
print ""
print "Installation takes 5-15 minutes. Please wait..."
print ""
if bash install.sh --product; then
  print ""
  print "=========================================="
  print "✓ Installation Succeeded!"
  print "=========================================="
  print ""
  print "Next steps:"
  print "  1. Create your first AI agent:"
  print "       ./jaeger agent create"
  print ""
  print "  2. Start chatting:"
  print "       ./jaeger              (Mac app or terminal)"
  print "     or"
  print "       ./jaeger webui start  (browser at http://localhost:8790)"
  print ""
  print "  3. Get help anytime:"
  print "       ./jaeger --help"
  print ""
  print "Documentation: docs/getting-started.md"
  print ""
  print "You can close this window now."
else
  print ""
  print "⚠️ Installation stopped. Review the message above, correct the issue,"
  print "and run this installer again."
  print ""
  print "Common fixes:"
  print "  • Install Xcode Command Line Tools: xcode-select --install"
  print "  • Install Python 3.12: brew install python@3.12"
  print "  • Free up disk space (needs ~15 GB)"
fi
read "?Press Return to close this window."

