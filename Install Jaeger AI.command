#!/bin/zsh
# Double-click on macOS to install or repair JaegerAI.
cd "${0:A:h}"
print "=========================================="
print "       Welcome to JaegerAI Installer      "
print "=========================================="
print ""
print "Installing modular JaegerAI packages + 5-Tab Studio WebUI..."
print ""
if bash ./install.sh --profile full; then
  print ""
  print "=========================================="
  print "✓ Installation Succeeded!"
  print "=========================================="
  print ""
  print "Next steps:"
  print "  1. Start the Gateway + 5-Tab Studio UI:"
  print "       ./jaeger start"
  print "  2. Chat in your terminal:"
  print "       ./jaeger"
  print "  3. Open the 5-Tab Studio UI + VR Avatar:"
  print "       ./jaeger open    (http://127.0.0.1:8790)"
  print "  4. Check system & hardware health:"
  print "       ./jaeger doctor"
  print ""
else
  print ""
  print "⚠️ Installation stopped. Check the output above and re-run."
fi
read "?Press Return to close this window."
