#!/usr/bin/env bash
# jaeger — clean operator launcher for JaegerAI (CLI / TUI / Gateway / Doctor / Setup).
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
REPO_ROOT="$(cd "$(dirname "$SELF")" && pwd)"
DEFAULT_VENV="${HOME}/.jaeger/venv"
if [[ "${1:-}" == "core" ]]; then
  DEFAULT_VENV="${HOME}/.jaeger/core-venv"
fi
VENV_PY="${JAEGER_VENV:-${DEFAULT_VENV}}/bin/python"

if [[ "${1:-}" == "setup" ]]; then
  shift
  exec bash "${REPO_ROOT}/scripts/setup.sh" "$@"
fi

if [[ ! -x "${VENV_PY}" ]]; then
  echo "[jaeger] Environment not installed yet at ${JAEGER_VENV:-${DEFAULT_VENV}}." >&2
  if [[ "${1:-}" == "core" ]]; then
    echo "Run: ./install.sh --profile core" >&2
  else
    echo "Run: ./install.sh  (or ./jaeger setup --profile full)" >&2
  fi
  exit 1
fi

export PYTHONDONTWRITEBYTECODE=1
export PYTHONPYCACHEPREFIX="${HOME}/.cache/jaeger/pycache"
export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

exec "${VENV_PY}" -B -m jaeger_ai "$@"
