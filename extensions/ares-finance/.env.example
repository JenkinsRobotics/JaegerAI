# ARES Finance Extension Configuration
FINANCE_PORT=3848
FINANCE_HOST=127.0.0.1
DATABASE_PATH=data/finance.db
AUTO_SYNC_INTERVAL_HOURS=6

# ── Monarch Money ────────────────────────────────────────────────────
# You do NOT have to put credentials here. The preferred path is to let the
# agent call the `monarch_setup` tool: you supply the email/password once, it
# mints a session, saves it to server/data/.mm_session, and the password is
# never stored. Later syncs reuse the session.
#
# These are only for unattended setups (cron, CI, a headless box) where no
# one can answer a prompt. Anything set here lives in plaintext on disk.

# Paths (optional). Defaults live under server/data/.
# ARES_FINANCE_DATA_DIR=
# ARES_FINANCE_DB=
# ARES_FINANCE_SESSION=

# An API token, if you have one — takes precedence over email/password.
# The Finance tab "Save & Connect" writes the same value into the local
# auth_tokens table, which the sidecar reads on every authenticate.
MONARCH_TOKEN=

MONARCH_EMAIL=
MONARCH_PASSWORD=

# TOTP secret (the base32 string behind the authenticator QR code), NOT a
# 6-digit code. Required for unattended login on an MFA-protected account;
# a one-time code can be passed to `monarch_setup` interactively instead.
MONARCH_MFA_SECRET=
