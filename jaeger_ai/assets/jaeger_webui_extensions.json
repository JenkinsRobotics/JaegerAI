{
  "extensions": [
    {
      "id": "jaeger-stream-continuity",
      "name": "Jaeger Stream Continuity",
      "scripts": [
        "jaeger_stream_continuity.js"
      ]
    },
    {
      "id": "jaeger-dispatcher",
      "name": "Jaeger Dispatcher and Focus",
      "scripts": [
        "jaeger_webui_branding.js",
        "jaeger_dispatcher.js"
      ],
      "sidecar": {
        "type": "loopback",
        "origin": "http://127.0.0.1:8646",
        "health_path": "/health",
        "proxy_auth": "token-v1"
      }
    },
    {
      "id": "jaeger-gateway-console",
      "name": "Jaeger Gateway Console",
      "scripts": [
        "jaeger_gateway_console.js"
      ]
    }
  ]
}
