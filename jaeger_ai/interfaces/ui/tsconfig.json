{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@jaeger/ui-protocol": ["../../../packages/jaeger-ui-protocol/src/index.ts"],
      "@jaeger/ui-sdk": ["../../../packages/jaeger-ui-sdk/src/index.ts"],
      "@jaeger/ui-kit": ["../../../packages/jaeger-ui-kit/src/index.ts"],
      "@jaeger/ui-kit/tokens.css": ["../../../packages/jaeger-ui-kit/src/tokens.css"],
      "@jaeger/ui-features": ["../../../packages/jaeger-ui-features/src/index.ts"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
