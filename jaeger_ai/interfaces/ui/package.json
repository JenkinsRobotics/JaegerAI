{
  "name": "jaeger-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Jaeger main screen: agents sidebar and chat, in the AetherStudio design language.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-theme-literals.mjs && tsc --noEmit && vite build && node scripts/check-no-mock.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:theme": "node scripts/check-theme-literals.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "check:no-mock": "node scripts/check-no-mock.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@rive-app/canvas": "^2.49.4",
    "codex-ui-kit": "0.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.55.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
