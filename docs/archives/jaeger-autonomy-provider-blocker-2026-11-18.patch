diff --git a/dev/tests/jaeger_ai/core/test_task_process_recovery.py b/dev/tests/jaeger_ai/core/test_task_process_recovery.py
new file mode 100644
index 0000000..8285e58
--- /dev/null
+++ b/dev/tests/jaeger_ai/core/test_task_process_recovery.py
@@ -0,0 +1,85 @@
+"""Process-level acceptance of the existing task owner; no model or production services.
+
+The controlled worker runs real regression tests, persists their output, and
+exits before task settlement. A new process must recover the receipt without
+running those tests a second time. This proves recovery, not autonomous coding.
+"""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import textwrap
+
+
+WORKER = textwrap.dedent('''
+    import asyncio, json, os, subprocess, sys
+    from pathlib import Path
+    from types import SimpleNamespace
+    from jaeger_ai.core.gateway.session_store import GatewaySessionStore
+    from jaeger_ai.core.gateway.event_bus import GatewayEventBus
+    from jaeger_ai.core.tasks.owner import GatewayTaskOwner
+
+    root, phase = Path(sys.argv[1]), sys.argv[2]
+    store = GatewaySessionStore(root / 'gateway.sqlite3')
+    store.ensure_session('review', workspace=str(root))
+    gateway = SimpleNamespace(store=store, event_bus=GatewayEventBus(store=store),
+                              _running_tasks={}, _cancellations=SimpleNamespace(cancel=lambda rid: None))
+    owner = GatewayTaskOwner(gateway)
+    if phase == 'submit':
+        admitted = owner.submit('Verify the provider-blocker candidate for owner review', context={
+            'session_id': 'review', 'request_id': 'candidate-check', 'source': 'client',
+            'execution': {'workspace': str(root)},
+        }, artifacts=['verification.log'])
+        print(json.dumps(admitted), flush=True)
+    else:
+        tid = owner.store.list_tasks()[0].task_id
+        def start(admitted, sid, prompt):
+            if phase != 'work':
+                raise AssertionError('Recovery repeated an already completed effect')
+            with (root / 'executions.txt').open('a') as marker:
+                marker.write('executed\\n')
+            with (root / 'verification.log').open('w') as log:
+                checked = subprocess.run([
+                    sys.executable, '-B', '-m', 'pytest',
+                    'dev/tests/jaeger_ai/core/test_gateway_single_terminal.py',
+                    '-q', '-p', 'no:cacheprovider', '-k', 'quota or background_transient',
+                ], stdout=log, stderr=subprocess.STDOUT, timeout=45)
+            store.complete_request(admitted['request_id'],
+                status='completed' if checked.returncode == 0 else 'failed',
+                result={'output': 'Candidate regression tests passed'} if checked.returncode == 0
+                       else {'error': 'Candidate regression tests failed'})
+            # Deliberate crash window: request committed, task not settled/delivered.
+            os._exit(23 if checked.returncode == 0 else 24)
+        gateway._start_admitted_turn = start
+        asyncio.run(owner._execute(tid))
+        asyncio.run(owner.tick())
+        print(json.dumps({'task': owner.store.get_task(tid).to_dict(),
+                          'messages': store.get_session('review')['messages']}), flush=True)
+''')
+
+
+def test_background_verification_survives_process_exit_without_reexecution(tmp_path):
+    repo = Path(__file__).resolve().parents[4]
+    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', JAEGER_NO_ATTACH='1', JAEGER_NO_GUI='1')
+
+    def run(phase):
+        return subprocess.run([sys.executable, '-B', '-c', WORKER, str(tmp_path), phase],
+                              cwd=repo, env=env, text=True, capture_output=True, timeout=60)
+
+    submitted = run('submit')
+    assert submitted.returncode == 0, submitted.stderr
+    assert json.loads(submitted.stdout)['status'] == 'queued'
+    worked = run('work')
+    assert worked.returncode == 23, (worked.stdout, worked.stderr,
+        (tmp_path / 'verification.log').read_text() if (tmp_path / 'verification.log').exists() else '')
+    for _ in range(2):
+        recovered = run('recover')
+        assert recovered.returncode == 0, recovered.stderr
+        saved = json.loads(recovered.stdout)
+        assert saved['task']['state'] == 'completed_verified'
+        assert saved['task']['payload']['verification'][0]['sha256']
+        assert len(saved['messages']) == 1
+        assert saved['messages'][0]['content'] == 'Candidate regression tests passed'
+    assert (tmp_path / 'executions.txt').read_text() == 'executed\n'
+    assert 'passed' in (tmp_path / 'verification.log').read_text()
