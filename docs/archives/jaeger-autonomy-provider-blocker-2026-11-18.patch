@@ -0,0 +1,36 @@
+import { render, screen, cleanup } from "@testing-library/react";
+import { afterEach, expect, it } from "vitest";
+import type { ChatPart } from "./host";
+import { mapEvent } from "./eventMap";
+import { requestOutcome, settleUnanswered } from "./requestOutcome";
+import { ModelError } from "./chatUx";
+
+afterEach(cleanup);
+const result = {
+  error: "CLI backend 'grok' exited: API error (status 402 Payment Required)",
+  user_message: "The model account is out of credits. Select another model or resolve billing.",
+  error_category: "quota", halt_reason: "needs_owner",
+};
+
+it("keeps the provider diagnosis and raw evidence identical in SSE and durable recovery", () => {
+  const live = mapEvent({ event: "turn.failed", payload: result });
+  const restored: ChatPart[] = [];
+  expect(requestOutcome({ request_id: "r", session_id: "s", status: "failed", result }, p => restored.push(p))).toBe("failed");
+  expect(restored).toEqual(live?.parts);
+  expect(restored).toEqual([{ kind: "error", message: result.error, headline: result.user_message }]);
+});
+
+it("restores the diagnosis after reloading an unanswered conversation without resubmitting", async () => {
+  const [turn] = await settleUnanswered([
+    { turnId: "t", requestId: "r", message: "Run the task", state: "pending", parts: [] },
+  ], async () => ({ request_id: "r", session_id: "s", status: "failed", result }));
+  expect(turn.state).toBe("failed");
+  expect(turn.parts[0]).toMatchObject({ headline: result.user_message, message: result.error });
+});
+
+it("renders the Gateway diagnosis as the headline and keeps raw evidence in Details", () => {
+  render(<ModelError details={[result.error]} headline={result.user_message} />);
+  expect(screen.getByRole("alert").querySelector(".jg-error__message")?.textContent).toBe(result.user_message);
+  expect(screen.getByText(result.error).closest("details")).not.toBeNull();
+  expect(screen.queryByText("Something went wrong with this reply.")).toBeNull();
+});
