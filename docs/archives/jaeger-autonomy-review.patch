index 8a684676..9c793fb9 100644
--- a/dev/tests/jaeger_ai/core/test_gateway_task_owner.py
+++ b/dev/tests/jaeger_ai/core/test_gateway_task_owner.py
@@ -209,6 +209,70 @@ def _finish_worker(owner, tid, result, *, status='completed', exhaust=False):
     return owner.store.get_task(tid)
 
 
+@pytest.mark.parametrize(('result', 'expected'), [
+    ({'halt_reason': 'yielded', 'output': 'Draft written; validation remains'}, TaskState.QUEUED),
+    ({'halt_reason': 'needs_owner', 'error': 'Choose the source'}, TaskState.NEEDS_OWNER),
+    ({'halt_reason': 'blocked', 'error': 'Required input unavailable'}, TaskState.BLOCKED),
+    ({'error': 'Validation failed'}, TaskState.FAILED),
+    ({'halt_reason': 'context_overflow'}, TaskState.FAILED),
+])
+def test_partial_artifact_cannot_override_worker_stop(owner, result, expected):
+    tid = owner.submit('Build and validate report', context=context(owner), artifacts=['report.txt'])['task_id']
+    (owner.store.db_path.parent / 'report.txt').write_text('unfinished draft')
+    finished = _finish_worker(owner, tid, result, exhaust=True)
+    assert finished.state == expected
+    if expected == TaskState.QUEUED:
+        assert finished.payload['attempt'] == 1
+        assert owner.gateway.store.get_session('parent')['messages'] == []
+    elif expected == TaskState.FAILED:
+        assert finished.error == result.get('error', result.get('halt_reason'))
+
+
+@pytest.mark.parametrize('first_result', [
+    {'halt_reason': 'yielded', 'output': 'Draft written; validate next'},
+    {'error': 'Validation failed', 'output': 'Draft written; validate next'},
+])
+def test_partial_checkpoint_resumes_after_owner_restart(owner, first_result):
+    """Persist real receipts/files; replace only the model worker with bounded work."""
+    tid = owner.submit('Build and validate report', context=context(owner), artifacts=['report.txt'])['task_id']
+    path = owner.store.db_path.parent / 'report.txt'
+    path.write_text('unfinished draft')
+    first = _finish_worker(owner, tid, first_result)
+    assert first.state == TaskState.QUEUED
+    assert owner.gateway.store.get_session('parent')['messages'] == []
+
+    # Reopen the database and event bus, not just the in-memory owner.
+    store = GatewaySessionStore(owner.store.db_path)
+    gateway = SimpleNamespace(store=store, event_bus=GatewayEventBus(store=store), _running_tasks={})
+    restored = GatewayTaskOwner(gateway)
+    restored.store.update_task(tid, lambda task: setattr(task, 'next_execution', 0))
+    launches = []
+
+    async def run():
+        def start(admitted, sid, prompt):
+            launches.append(admitted['request_id'])
+            assert 'Draft written; validate next' in prompt
+            async def work():
+                assert path.read_text() == 'unfinished draft'
+                path.write_text('validated final report')
+                store.complete_request(admitted['request_id'], status='completed',
+                                       result={'output': 'Report validated'})
+            gateway._running_tasks[admitted['request_id']] = asyncio.create_task(work())
+        gateway._start_admitted_turn = start
+        await restored.tick()
+        await asyncio.gather(*restored._active.values())
+        await restored.tick()
+        await restored.stop()
+    asyncio.run(run())
+    assert launches == [f'{tid}:1']
+    finished = restored.store.get_task(tid)
+    assert finished.state == TaskState.COMPLETED_VERIFIED
+    assert finished.error is None
+    assert path.read_text() == 'validated final report'
+    assert [m['content'] for m in store.get_session('parent')['messages']] == ['Report validated']
+    assert finished.payload['verification'][0]['sha256']
+
+
