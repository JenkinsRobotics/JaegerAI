diff --git a/jaeger_ai/core/tasks/owner.py b/jaeger_ai/core/tasks/owner.py
index a66ee91d..fc987ba4 100644
--- a/jaeger_ai/core/tasks/owner.py
+++ b/jaeger_ai/core/tasks/owner.py
@@ -661,7 +661,15 @@ class GatewayTaskOwner:
         result = row.get('result') or {}
         if status in {'admitted', 'running'}:
             return
-        verified, evidence = self.verify(task, result) if status == 'completed' else (False, '')
+        # A completed request may only be a checkpoint or a request for input.
+        # Files written before that stop are not proof the objective finished.
+        # Respect the worker outcome before inspecting artifacts, including on
+        # recovery from a persisted receipt (no worker is rerun in that case).
+        incomplete = result.get('error') or result.get('halt_reason')
+        verified, evidence = (
+            self.verify(task, result) if status == 'completed' and not incomplete
+            else (False, str(incomplete or ''))
+        )
         def settle(current):
             if current.state == TaskState.CANCELLED:
                 return
@@ -674,7 +682,7 @@ class GatewayTaskOwner:
             elif verified:
                 try:
                     authoritative_transition(
-                        current, TaskState.COMPLETED_VERIFIED, evidence=evidence,
+                        current, TaskState.COMPLETED_VERIFIED, evidence=evidence, error=None,
                     )
                 except CompletionError as exc:
                     authoritative_transition(current, TaskState.FAILED, error=str(exc))
